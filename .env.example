# Credenciais fictícias para o PostgreSQL local. Troque a senha no seu .env.
POSTGRES_USER=resolva
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_DB=resolva
POSTGRES_PORT=5433
DATABASE_URL=postgresql://resolva:troque_esta_senha_local@127.0.0.1:5433/resolva

# Opcional enquanto não houver projeto-alvo e integrações configurados.
RESOLVA_CONFIG_PATH=resolva.config.json
GH_TOKEN=
KIRO_API_KEY=
